# Node 24+; copy to .env. Never commit credentials.
HOST=127.0.0.1
PORT=4310
DATA_DIR=.local
# Public HTTPS origin when hosted. The reverse proxy must preserve Origin.
# APP_ORIGIN=https://fenext.example.com
# For remote first-account creation, set a long random setup token.
# SETUP_TOKEN=
# Required for hosted deployments: 64 hex characters, retained with backups.
# MASTER_KEY=
# Provider endpoints must be explicitly allowed, not arbitrary user URLs.
AI_ALLOWED_HOSTS=api.openai.com,api.deepseek.com,dashscope.aliyuncs.com
WORKER_POLL_MS=1500
MAX_ATTEMPTS=3
# Optional external search, only called after the user clicks supplement.
# TAVILY_API_KEY=
# Desktop shell connects to the independently running service.
FENEXT_APP_URL=http://127.0.0.1:4310
