<view class="page"
  ><view class="header"
    ><view class="eyebrow">CAPTURE YOUR CURIOSITY</view
    ><view class="title">收集资料</view
    ><view class="subtitle">留下内容，以及你想弄明白的问题。</view></view
  ><view class="label">文章或论文链接</view
  ><input
    data-field="url"
    bindinput="input"
    value="{{url}}"
    placeholder="https://…"
  />
  ><view wx:if="{{url}}" class="label">
    <switch checked="{{urlMode === 'reference'}}" bindchange="reference" />链接仅作为来源记录，不再次读取
  </view>
  <view wx:if="{{url && urlMode === 'reference'}}" class="muted">请同时提供正文或图片；只会整理你提交的内容。</view>
  <view class="label">文字内容</view><textarea
    data-field="text"
    maxlength="60000"
    bindinput="input"
    value="{{text}}"
    placeholder="粘贴资料或一个陌生概念…"
  /><view class="grid"
    ><view wx:for="{{images}}" wx:key="index"
      ><image class="thumb" src="{{item.data}}" mode="aspectFill" /><view
        class="link"
        data-index="{{index}}"
        bindtap="remove"
        >移除</view
      ></view
    ></view
  ><button wx:if="{{images.length < 4}}" class="secondary" bindtap="addImage">
    添加图片 · 每张最多 2 MB</button
  ><view class="label">你想了解什么？（选填）</view
  ><textarea
    data-field="question"
    bindinput="input"
    value="{{question}}"
    placeholder="例如：它解决什么产品问题？"
  /><view wx:if="{{error}}" class="error">{{error}}</view
  ><view class="small">{{saved}}</view
  ><button
    class="primary"
    bindtap="submit"
    loading="{{busy}}"
    disabled="{{busy || (!text && !images.length && (!url || urlMode === 'reference'))}}"
  >
    提交并整理
  </button></view
>
