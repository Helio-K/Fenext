{
  "name": "fenext",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fenext — 把读到的资料，变成用得上的知识",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "worker": "node server/worker.mjs",
    "build": "vite build",
    "web": "node scripts/start-web.mjs",
    "web:package": "npm run build && npm run extension:package && node scripts/package-web.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "desktop": "electron .",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:mac": "npm run build && electron-builder --mac zip",
    "desktop:win": "npm run build && electron-builder --win nsis",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write src server desktop scripts tests",
    "extension:package": "node scripts/package-extension.mjs"
  },
  "build": {
    "appId": "app.fenext.desktop",
    "productName": "Fenext",
    "files": [
      "desktop/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "desktop/assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": "zip"
    },
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": "nsis"
    }
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "undici": "^8.11.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "yazl": "^3.3.1"
  }
}
